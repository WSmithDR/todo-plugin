#!/bin/bash
# post-commit: auto-bump de la versión en cli-config.yaml, regeneración de los
# manifiestos de todos los CLIs, y amend del commit.
#
# Corre después del commit → lee el mensaje, calcula el bump, amenda con
# --no-verify. El --no-verify es seguro porque los tests ya corrieron en pre-commit.
#
# La versión vive en UN solo lugar —cli-config.yaml— y de ahí se proyecta a cada
# manifiesto. Antes este hook escribía directo .claude-plugin/plugin.json y nadie
# tocaba marketplace.json: llegó a estar 21 minors atrás (1.0.0 vs 1.21.11).
# Un solo escritor es lo que hace que ese drift no pueda volver.
#
# feat:              → minor
# fix|chore|docs|... → patch
# BREAKING (en msg)  → major

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CLI_CONFIG="$REPO_ROOT/cli-config.yaml"
GENERATOR="$REPO_ROOT/bin/dev/generate-cli-configs.py"
SENTINEL="$REPO_ROOT/.git/.version-bump-in-progress"

# Recursion guard: el `git commit --amend` de más abajo re-dispara post-commit
# (--no-verify NO saltea post-commit). El sentinel frena la segunda invocación.
if [ -f "$SENTINEL" ]; then
    rm -f "$SENTINEL"
    exit 0
fi

[ ! -f "$CLI_CONFIG" ] && exit 0
[ ! -f "$GENERATOR" ] && exit 0

# Bump manual: la LÍNEA de la versión cambió en este commit → no tocar.
#
# Se mira la línea y no el archivo: cli-config.yaml también se edita para cambiar
# una descripción, un keyword o una ruta, y esos commits tienen que bumpear igual.
# Mirando el archivo entero quedaban sin versión nueva y en silencio.
if git show -U0 --format="" HEAD -- cli-config.yaml | grep -qE '^\+  version:'; then
    exit 0
fi

MSG=$(git log -1 --pretty=%B)

# Determinar tipo de bump
if echo "$MSG" | grep -qiE "(BREAKING[ -]CHANGE|^.+!:)"; then
    BUMP="major"
elif echo "$MSG" | grep -qiE "^feat(\(.+\))?:"; then
    BUMP="minor"
else
    BUMP="patch"
fi

# Se lee y escribe la versión con un reemplazo de línea — el YAML NO se
# round-trippea por pyyaml, que borraría todos los comentarios del archivo.
VERSIONS=$(CLI_CONFIG="$CLI_CONFIG" BUMP="$BUMP" python3 -c '
import os, re, sys

path = os.environ["CLI_CONFIG"]
text = open(path, encoding="utf-8").read()

m = re.search(r"^(  version:\s*\")(\d+\.\d+\.\d+)(\")$", text, re.M)
if not m:
    sys.exit("no se encontró una version válida en cli-config.yaml")

major, minor, patch = map(int, m.group(2).split("."))
bump = os.environ["BUMP"]
if bump == "major":
    major, minor, patch = major + 1, 0, 0
elif bump == "minor":
    minor, patch = minor + 1, 0
else:
    patch += 1
new = f"{major}.{minor}.{patch}"

open(path, "w", encoding="utf-8").write(
    text[:m.start()] + m.group(1) + new + m.group(3) + text[m.end():]
)
print(m.group(2), new)
')
CURRENT="${VERSIONS%% *}"
NEW="${VERSIONS##* }"

python3 "$GENERATOR" > /dev/null

# Se stagea lo que el generador DECLARA que genera, para no duplicar la lista
# acá — donde se desincronizaría en cuanto se agregue un CLI.
git -C "$REPO_ROOT" add "$CLI_CONFIG"
while read -r rel; do
    [ -n "$rel" ] && git -C "$REPO_ROOT" add "$REPO_ROOT/$rel"
done < <(python3 "$GENERATOR" --list)

touch "$SENTINEL"
git commit --amend --no-edit --no-verify
rm -f "$SENTINEL"
echo "  version: $CURRENT → $NEW ($BUMP)"
